{# Usage: {% set contactTag = "GET IN TOUCH" %}{% include "contact-section.njk" %} #}
<section id="contact" style="position:relative;z-index:2;padding:80px 0">
  <div class="container" style="max-width:1200px;margin:0 auto;padding:0 24px">
    <div class="contact-wrap">

      <!-- LEFT: Contact info -->
      <div class="contact-info">
        <div class="sec-tag">{{ contactTag | default("GET IN TOUCH") }}</div>
        <h2 class="sec-title" style="margin-bottom:16px">{{ contactTitle | default('Let\'s Build Something <em style="font-style:normal;background:linear-gradient(135deg,var(--M),var(--B),var(--C));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent">Amazing</em>') | safe }}</h2>
        <p class="sec-sub" style="margin-bottom:40px">{{ contactSub | default("Fill out the form and our technical team will contact you within 24 hours with a personalized proposal.") }}</p>

        <div class="contact-info-item">
          <div class="contact-info-icon" style="background:rgba(0,206,209,0.1);border:1px solid rgba(0,206,209,0.2)">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#00CED1" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
          </div>
          <div>
            <div class="contact-info-title">Direct Phone</div>
            <div class="contact-info-text">{{ site.phone_display }}</div>
          </div>
        </div>

        <div class="contact-info-item">
          <div class="contact-info-icon" style="background:rgba(224,26,89,0.1);border:1px solid rgba(224,26,89,0.2)">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#E01A59" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </div>
          <div>
            <div class="contact-info-title">Email</div>
            <div class="contact-info-text">{{ site.email }}</div>
          </div>
        </div>

        <div class="contact-info-item">
          <div class="contact-info-icon" style="background:rgba(0,123,255,0.1);border:1px solid rgba(0,123,255,0.2)">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#007BFF" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <div>
            <div class="contact-info-title">Address</div>
            <div class="contact-info-text">{{ site.address_full | safe }}</div>
          </div>
        </div>

        <div style="margin-top:32px;padding:20px 24px;background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);border-radius:16px">
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px">
            <div style="width:8px;height:8px;border-radius:50%;background:#4CAF50;box-shadow:0 0 8px rgba(76,175,80,0.8)"></div>
            <span style="font-family:var(--fd);font-weight:700;font-size:0.82rem">{{ site.response_time }}</span>
          </div>
          <div style="font-size:0.78rem;color:var(--soft);line-height:1.6">Our technical team reviews every request and prepares a detailed proposal for your project.</div>
        </div>
      </div>

      <!-- RIGHT: Lead form -->
      <div class="contact-form-card">
        <div class="contact-form-title">Get Your Free Quote</div>
        <div class="contact-form-sub">Tell us about your project and we'll design the perfect LED solution.</div>

        <form class="lead-form" action="#" method="POST" onsubmit="event.preventDefault();">
          <div class="form-row">
            <div class="form-group">
              <label class="form-label">Full Name <span class="req">*</span></label>
              <input type="text" class="form-input" name="name" placeholder="John Smith" required>
            </div>
            <div class="form-group">
              <label class="form-label">Email <span class="req">*</span></label>
              <input type="email" class="form-input" name="email" placeholder="john@company.com" required>
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label">Phone</label>
              <input type="tel" class="form-input" name="phone" placeholder="+1 (555) 000-0000">
            </div>
            <div class="form-group">
              <label class="form-label">What are you looking for?</label>
              <select class="form-input" name="interest">
                <option value="" disabled selected>Select an option...</option>
                <option value="house-of-worship">House of Worship</option>
                <option value="virtual-production">Virtual Production</option>
                <option value="airport-transit">Airport / Transit</option>
                <option value="retail-mall">Retail / Mall</option>
                <option value="trade-show">Trade Show</option>
                <option value="other">Other</option>
              </select>
            </div>
          </div>
          <div class="form-row">
            <div class="form-group full">
              <label class="form-label">Message</label>
              <textarea class="form-textarea" name="message" placeholder="Tell us about your space, audience size, and what you're looking for..."></textarea>
            </div>
          </div>
          <button type="submit" class="btn-glass glass-full glass-m"><span class="blob"></span><span class="btn-inner">Get Your Free Quote &rarr;</span></button>
          <div class="form-disclaimer">By submitting this form you agree to our terms of service and privacy policy. We never share your information with third parties.</div>
        </form>
      </div>

    </div>
  </div>
</section>
