<!-- ════ NAVIGATION ════ -->
<nav id="mainNav">
  <a href="/" class="nav-logo" style="text-decoration:none">
    <img src="{{ site.logo_url }}" alt="BEZALED Display Solutions" style="height:28px;width:auto;filter:invert(1) drop-shadow(0 0 8px rgba(0,206,209,0.5)) drop-shadow(0 0 20px rgba(224,26,89,0.3))">
  </a>

  <div class="nav-links">
    {%- for item in menu.items %}
    {%- if item.icon == "users" %}
    <a href="{{ item.href }}" class="nav-btn" style="text-decoration:none"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>{{ item.label }}</a>
    {%- endif %}
    {%- endfor %}

    <!-- Solutions dropdown -->
    <div class="nav-group">
      <button class="nav-btn"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>Solutions <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg></button>
      <div class="nav-dropdown">
        {%- for sol in collections.solutions %}
        <a href="{{ sol.data.permalink }}">{{ sol.data.nav_label }}</a>
        {%- endfor %}
        <div class="nav-dropdown-divider"></div>
        <a href="/#contact">Financing</a>
      </div>
    </div>

    <!-- Products dropdown -->
    <div class="nav-group">
      <button class="nav-btn"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="1" width="10" height="10" rx="1"/><rect x="13" y="1" width="10" height="10" rx="1"/><rect x="1" y="13" width="10" height="10" rx="1"/><rect x="13" y="13" width="10" height="10" rx="1"/></svg>Products <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg></button>
      <div class="nav-dropdown">
        {%- for prod in collections.products %}
        <a href="{{ prod.data.permalink }}">{{ prod.data.title }}{% if prod.data.badge == "BEST SELLER" %} <span class="badge-bestseller">Best Seller</span>{% endif %}</a>
        {%- endfor %}
        <div class="nav-dropdown-divider"></div>
        <a href="/products/">All Products</a>
      </div>
    </div>

    {%- for item in menu.items %}
    {%- if item.icon == "headphones" %}
    <a href="{{ item.href }}" class="nav-btn" style="text-decoration:none"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/></svg>{{ item.label }}</a>
    {%- elif item.icon == "gallery" %}
    <a href="{{ item.href }}" class="nav-btn" style="text-decoration:none"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="1" width="9" height="13" rx="1.5"/><rect x="14" y="1" width="9" height="7" rx="1.5"/><rect x="14" y="12" width="9" height="11" rx="1.5"/><rect x="1" y="18" width="9" height="5" rx="1.5"/></svg>{{ item.label }}</a>
    {%- endif %}
    {%- endfor %}
  </div>

  <div style="display:flex;align-items:center;gap:8px">
    <div class="nav-separator"></div>
    <a href="tel:{{ site.phone }}" class="nav-phone" title="{{ site.phone_display }}">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
    </a>
    <a href="{{ menu.cta_href }}" class="btn-glass glass-nav glass-m" style="text-decoration:none"><span class="blob"></span><span class="btn-inner">{{ menu.cta_text }}</span></a>
  </div>

  <button id="navBurger" onclick="toggleMobileMenu()" style="background:none;border:none;cursor:pointer;padding:8px;color:var(--white)">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
  </button>
</nav>
