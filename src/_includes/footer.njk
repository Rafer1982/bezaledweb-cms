<!-- ════ FOOTER ════ -->
<footer>
  <div class="footer-main">
    <div>
      <div class="footer-brand-name">{{ site.company_name }}</div>
      <div class="footer-brand-sub">{{ site.company_sub }}</div>
      <p class="footer-desc">{{ site.footer_desc }}</p>
      <div class="footer-newsletter" style="margin-bottom:20px">
        <input class="footer-input" type="email" placeholder="you@email.com">
        <button class="btn-glass glass-sm glass-m"><span class="blob"></span><span class="btn-inner">Subscribe</span></button>
      </div>
      <div style="display:flex;gap:8px">
        {%- for social in footer.social_links %}
        <a href="{{ social.href }}" style="width:32px;height:32px;border-radius:9px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);display:flex;align-items:center;justify-content:center;font-size:0.82rem;text-decoration:none;transition:background 0.2s;color:var(--white)" onmouseover="this.style.background='rgba(255,255,255,0.12)'" onmouseout="this.style.background='rgba(255,255,255,0.05)'">{{ social.icon | safe }}</a>
        {%- endfor %}
      </div>
    </div>
    <div>
      <div class="footer-col-title">Products</div>
      {%- for prod in collections.products %}
      <a href="{{ prod.data.permalink }}" class="footer-link">{{ prod.data.title }}</a>
      {%- endfor %}
      <a href="/products/" class="footer-link footer-link-accent" style="margin-top:4px">View catalog &rarr;</a>
    </div>
    <div>
      <div class="footer-col-title">Solutions</div>
      {%- for sol in collections.solutions %}
      <a href="{{ sol.data.permalink }}" class="footer-link">{{ sol.data.nav_label }}</a>
      {%- endfor %}
    </div>
    <div>
      <div class="footer-col-title">Company</div>
      {%- for link in footer.company_links %}
      <a href="{{ link.href }}" class="footer-link">{{ link.label }}</a>
      {%- endfor %}
      <a href="{{ footer.cta_href }}" class="footer-link footer-link-accent" style="color:var(--M);margin-top:4px">{{ footer.cta_text | safe }}</a>
    </div>
  </div>
  <div class="footer-bottom">
    <div class="footer-copy">&copy; 2026 {{ site.company_name }} {{ site.company_sub }}. {{ footer.copyright_suffix }}</div>
    <div class="footer-legal">
      <a href="/support/">Warranty & Terms</a>
    </div>
    <div class="footer-status">
      <div class="status-dot"></div>
      <span>All systems operational</span>
    </div>
  </div>
</footer>
