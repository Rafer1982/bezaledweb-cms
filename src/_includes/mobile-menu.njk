<!-- MOBILE MENU OVERLAY -->
<div id="mobileMenu" style="display:none;position:fixed;inset:0;z-index:999;background:rgba(7,9,14,0.97);backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);padding:80px 24px 40px;flex-direction:column;gap:6px;overflow-y:auto">
  <button onclick="toggleMobileMenu()" style="position:absolute;top:76px;right:20px;background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.15);border-radius:12px;padding:10px 18px;color:var(--white);font-family:var(--fd);font-size:0.85rem;cursor:pointer">&#10005; Close</button>
  {%- for item in menu.items %}
  {%- if item.icon == "users" %}
  <a href="{{ item.href }}" style="display:flex;align-items:center;gap:12px;padding:18px 24px;font-family:var(--fd);font-weight:600;font-size:1.15rem;color:rgba(255,255,255,0.9);text-decoration:none;border-radius:14px">{{ item.label }}</a>
  {%- endif %}
  {%- endfor %}
  <div style="padding:0 24px;margin-bottom:4px"><div style="font-size:0.65rem;letter-spacing:2px;text-transform:uppercase;color:var(--soft);font-family:var(--fd)">Solutions</div></div>
  {%- for sol in collections.solutions %}
  <a href="{{ sol.data.permalink }}" style="display:flex;align-items:center;gap:12px;padding:14px 24px 14px 40px;font-family:var(--fb);font-weight:500;font-size:1rem;color:rgba(255,255,255,0.7);text-decoration:none;border-radius:14px">{{ sol.data.nav_label }}</a>
  {%- endfor %}
  <div style="padding:0 24px;margin-top:12px;margin-bottom:4px"><div style="font-size:0.65rem;letter-spacing:2px;text-transform:uppercase;color:var(--soft);font-family:var(--fd)">Products</div></div>
  {%- for prod in collections.products %}
  <a href="{{ prod.data.permalink }}" style="display:flex;align-items:center;gap:12px;padding:14px 24px 14px 40px;font-family:var(--fb);font-weight:500;font-size:1rem;color:rgba(255,255,255,0.7);text-decoration:none;border-radius:14px">{{ prod.data.title }}</a>
  {%- endfor %}
  <a href="/products/" style="display:flex;align-items:center;gap:12px;padding:14px 24px 14px 40px;font-family:var(--fb);font-weight:500;font-size:1rem;color:rgba(255,255,255,0.7);text-decoration:none;border-radius:14px">All Products</a>
  {%- for item in menu.items %}
  {%- if item.icon == "gallery" %}
  <a href="{{ item.href }}" style="display:flex;align-items:center;gap:12px;padding:18px 24px;font-family:var(--fd);font-weight:600;font-size:1.15rem;color:rgba(255,255,255,0.9);text-decoration:none;border-radius:14px">{{ item.label }}</a>
  {%- endif %}
  {%- if item.icon == "headphones" %}
  <a href="{{ item.href }}" style="display:flex;align-items:center;gap:12px;padding:18px 24px;font-family:var(--fd);font-weight:600;font-size:1.15rem;color:rgba(255,255,255,0.9);text-decoration:none;border-radius:14px;margin-top:8px">{{ item.label }}</a>
  {%- endif %}
  {%- endfor %}
  <a href="{{ menu.cta_href }}" class="btn-glass glass-full glass-m" style="text-decoration:none;margin-top:20px"><span class="blob"></span><span class="btn-inner">{{ menu.cta_text }} &rarr;</span></a>
</div>
