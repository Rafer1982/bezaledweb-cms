<!-- ════ STATS BAND ════ -->
<section id="stats">
  <div class="container">
    <div class="stats-grid">
      <div class="stat-item">
        <div class="stat-num" data-val="500" data-suffix="+" style="background:linear-gradient(135deg,var(--M),var(--B));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent">500+</div>
        <div class="stat-lbl">Installations</div>
        <div class="stat-sub">across the United States</div>
      </div>
      <div class="stat-item">
        <div class="stat-num" data-val="5" data-suffix="" style="background:linear-gradient(135deg,var(--B),var(--C));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent">5</div>
        <div class="stat-lbl">Year Warranty</div>
        <div class="stat-sub">on every LED display</div>
      </div>
      <div class="stat-item">
        <div class="stat-num" style="background:linear-gradient(135deg,var(--C),var(--P));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent">24/7</div>
        <div class="stat-lbl">Support</div>
        <div class="stat-sub">US-based technical team</div>
      </div>
      <div class="stat-item">
        <div class="stat-num" data-val="100" data-suffix="K+" style="background:linear-gradient(135deg,var(--P),var(--M));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent">100K+</div>
        <div class="stat-lbl">Hours Lifespan</div>
        <div class="stat-sub">industry-leading durability</div>
      </div>
    </div>
  </div>
</section>


<!-- ════ TESTIMONIALS ════ -->
<section id="testimonials" style="padding:80px 0">
  <div class="container">
    <div class="sec-tag">TESTIMONIALS</div>
    <h2 class="sec-title" style="margin-bottom:16px">Trusted by Organizations<br>Across the <em style="font-style:normal;background:linear-gradient(135deg,var(--M),var(--B),var(--C));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent">U.S.</em></h2>
    <p class="sec-sub">Over 500 organizations across the United States trust BEZALED for their most important installations.</p>
    <div class="testi-grid">

      {% for t in testimonials.items %}
      <div class="testi-card">
        <div class="testi-q">&ldquo;</div>
        <div class="testi-text">{{ t.quote }}</div>
        <div class="testi-author">
          <div class="testi-av" style="background:linear-gradient(135deg,{% if t.avatar_gradient == 'magenta' %}var(--M),var(--P){% elif t.avatar_gradient == 'blue' %}var(--B),var(--C){% elif t.avatar_gradient == 'cyan' %}var(--C),var(--P){% else %}var(--M),var(--B){% endif %})">{{ t.initials }}</div>
          <div><div class="testi-name">{{ t.name }}</div><div class="testi-venue">{{ t.role }}</div></div>
          <div class="testi-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        </div>
      </div>
      {% endfor %}

    </div>
  </div>
</section>


