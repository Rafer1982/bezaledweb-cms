---
layout: base.njk
pageTitle: "Our Work — Project Gallery — BEZALED Display Solutions"
metaDescription: "See our LED display installations across the United States. Churches, virtual production studios, airports, retail spaces, and event venues."
---

<!-- ════ PAGE HERO ════ -->
<section class="page-hero" style="position:relative;z-index:2">
  <div class="page-hero-bg">
    <div class="img-placeholder" style="aspect-ratio:16/9;width:100%;height:100%;border-radius:0">
      <div style="text-align:center; color: rgba(255,255,255,0.3);">
        <div style="font-size:2rem; margin-bottom:8px;">&#128248;</div>
        <div style="font-size:0.75rem; font-family: var(--fb); letter-spacing:2px; text-transform:uppercase;">[GALLERY HERO &mdash; LED INSTALLATION MONTAGE]</div>
      </div>
    </div>
  </div>
  <div class="page-hero-inner" style="max-width:720px">
    <div class="page-hero-tag">OUR WORK</div>
    <h1 class="page-hero-title">Every Installation Tells a Story</h1>
    <p class="page-hero-desc">From the first consultation to the final pixel &mdash; browse our portfolio of LED display projects across the United States.</p>
  </div>
</section>


<!-- ════ PROJECT GALLERY ════ -->
<section id="gallery" style="padding:80px 0;position:relative;z-index:2">
  <div class="container">
    <div class="sec-tag">PORTFOLIO</div>
    <h2 class="sec-title" style="margin-bottom:16px">Installations that <em style="font-style:normal;background:linear-gradient(135deg,var(--M),var(--B),var(--C));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent">speak for themselves</em></h2>
    <p class="sec-sub">From intimate worship spaces to massive concert stages. Every project is designed, installed, and supported by the BEZALED team.</p>

    <div class="gallery-filters">
      <button class="gf-btn active" data-filter="all"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg> All Projects</button>
      <button class="gf-btn" data-filter="worship"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="2" x2="12" y2="22"/><line x1="4" y1="9" x2="20" y2="9"/></svg> House of Worship</button>
      <button class="gf-btn" data-filter="production"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 7l-7 5 7 5V7z"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg> Virtual Productions</button>
      <button class="gf-btn" data-filter="airports"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.8 19.2L16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/></svg> Airports</button>
      <button class="gf-btn" data-filter="retail"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg> Retail</button>
      <button class="gf-btn" data-filter="events"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg> Trade Shows</button>
    </div>
    <div class="gallery-count" id="galCount">Showing {{ collections.projects.length }} of {{ collections.projects.length }} projects</div>

    <div class="masonry-grid" id="masonryGallery">
      {% for project in collections.projects %}
      <div class="masonry-item {{ project.data.size_class }} fade-in" data-cat="{{ project.data.category }}">
        {% if project.data.image %}
        <img src="{{ project.data.image }}" alt="{{ project.data.title }}" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover">
        {% else %}
        <div class="img-placeholder" style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;">
          <div style="text-align:center; color: rgba(255,255,255,0.3);">
            <div style="font-size:1.5rem; margin-bottom:6px;">&#128248;</div>
            <div style="font-size:0.65rem; font-family: var(--fb); letter-spacing:2px; text-transform:uppercase;">[{{ project.data.title | upper }}]</div>
          </div>
        </div>
        {% endif %}
        <div class="masonry-overlay">
          <span class="m-tag">{{ project.data.tag_label }}</span>
          <div class="m-caption">{{ project.data.title }}</div>
        </div>
        <span class="gallery-zoom"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></span>
      </div>
      {% endfor %}
    </div>
  </div>
</section>


{% include "contact-section.njk" %}
