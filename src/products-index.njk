---
layout: base.njk
pageTitle: "LED Display Products — BEZALED"
metaDescription: "Browse BEZALED's complete LED display product lineup. Indoor panels from P2.5 to P3.9, outdoor displays, and custom solutions. 5-year warranty, financing from $999/mo."
permalink: /products/
---

<!-- ════ 1. PAGE HERO ════ -->
<section class="page-hero" style="position:relative;min-height:500px;display:flex;align-items:center;overflow:hidden;padding:0">
  <div style="position:absolute;inset:0;z-index:0;background:var(--card-2)">
    <div class="img-placeholder" style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;">
      <div style="text-align:center; color: rgba(255,255,255,0.3);"><div style="font-size:2rem; margin-bottom:8px;">&#128248;</div><div style="font-size:0.75rem; font-family: var(--fb); letter-spacing:2px; text-transform:uppercase;">[PRODUCT CATALOG HERO]</div></div>
    </div>
    <div style="position:absolute;inset:0;background:linear-gradient(to right, rgba(7,9,14,0.88) 0%, rgba(7,9,14,0.55) 45%, rgba(7,9,14,0.2) 100%);z-index:1"></div>
    <div style="position:absolute;inset:0;background:linear-gradient(to bottom, rgba(7,9,14,0.5) 0%, transparent 30%, transparent 70%, rgba(7,9,14,0.85) 100%);z-index:1"></div>
  </div>

  <div class="hero-accent-bar" style="position:absolute;top:0;left:0;right:0;height:2px;z-index:3;background:linear-gradient(90deg,var(--M),var(--B),var(--C),var(--P),var(--M));background-size:200% 100%;animation:barShift 4s linear infinite"></div>

  <div style="position:relative;z-index:2;width:100%;max-width:1200px;margin:0 auto;padding:clamp(120px,14vh,180px) clamp(24px,4vw,80px) 80px">
    <div style="max-width:620px">
      <div class="hero-tag" style="display:inline-flex;align-items:center;gap:8px;padding:6px 16px;border-radius:50px;border:1px solid rgba(0,206,209,0.3);background:rgba(0,206,209,0.06);backdrop-filter:blur(12px);margin-bottom:14px;width:fit-content">
        <div class="hero-tag-dot" style="width:7px;height:7px;border-radius:50%;background:var(--C);box-shadow:0 0 10px rgba(0,206,209,0.9);animation:pulse 2s ease-in-out infinite"></div>
        <span style="font-size:0.71rem;color:var(--C);letter-spacing:2.5px;text-transform:uppercase;font-family:var(--fd);font-weight:600">OUR PRODUCTS</span>
      </div>

      <h1 style="font-family:var(--fd);font-weight:700;font-size:clamp(2rem,3.5vw,3.2rem);line-height:1.08;letter-spacing:-0.02em;margin-bottom:18px;color:#fff;text-shadow:0 2px 24px rgba(0,0,0,0.9),0 0 60px rgba(0,0,0,0.7)">
        LED Displays Built for <em style="font-style:normal;background:linear-gradient(135deg,#ffffff,#e0e7ff,#ffffff);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;text-shadow:none">Every Application</em>
      </h1>

      <p style="font-size:0.95rem;color:rgba(255,255,255,0.82);line-height:1.65;max-width:500px;margin-bottom:28px;text-shadow:0 1px 12px rgba(0,0,0,0.8)">
        From fine-pitch indoor panels to weather-resistant outdoor displays &mdash; find the perfect LED solution for your space.
      </p>

      <div style="display:flex;gap:12px;flex-wrap:wrap">
        <a href="#contact" class="btn-glass glass-m" style="text-decoration:none"><span class="blob"></span><span class="btn-inner">Get a Custom Quote &rarr;</span></a>
        <a href="#compare" class="btn-glass glass-c" style="text-decoration:none"><span class="blob"></span><span class="btn-inner">Compare Models</span></a>
      </div>
    </div>
  </div>
</section>


<!-- ════ 2. PRODUCT GRID ════ -->
<section style="position:relative;z-index:2;padding:80px 0">
  <div class="container" style="max-width:1200px;margin:0 auto;padding:0 24px">
    <div style="text-align:center;margin-bottom:64px">
      <div class="sec-tag" style="justify-content:center">Product Lineup</div>
      <h2 class="sec-title" style="margin:0 auto 18px">Choose Your <em style="font-style:normal;background:linear-gradient(135deg,var(--M),var(--B),var(--C));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent">Display</em></h2>
    </div>

    <div class="products-grid" style="display:grid;grid-template-columns:repeat(2,1fr);gap:20px">

      {% for product in collections.products | sort(false, false, 'data.order') %}
      <div class="glow-wrap"><div class="p-card">
        <div class="p-card-img" style="background:var(--card-2)">
          <div class="bg-orb" style="width:200px;height:200px;background:var(--C);top:-50px;left:-50px;opacity:0.35"></div>
          <div class="bg-orb" style="width:160px;height:160px;background:var(--B);bottom:-40px;right:-40px;opacity:0.35"></div>
          <span class="p-card-badge" style="{{ product.data.badge_style }}">{{ product.data.badge }}</span>
          <div style="position:absolute;inset:0;overflow:hidden;display:flex;align-items:center;justify-content:center">
            {% if product.data.card_image %}
            <img src="{{ product.data.card_image }}" alt="{{ product.data.title }}" style="width:100%;height:100%;object-fit:cover">
            {% else %}
            <div class="img-placeholder" style="width:100%;height:100%;display:flex;align-items:center;justify-content:center">
              <div style="text-align:center; color: rgba(255,255,255,0.3);"><div style="font-size:2rem; margin-bottom:8px;">&#128248;</div><div style="font-size:0.75rem; font-family: var(--fb); letter-spacing:2px; text-transform:uppercase;">[{{ product.data.slug | upper }} PRODUCT]</div></div>
            </div>
            {% endif %}
          </div>
          <div style="position:absolute;bottom:12px;left:0;right:0;text-align:center;z-index:2">
            <div style="font-family:var(--fd);font-weight:700;font-size:0.7rem;color:var(--C);letter-spacing:2px">{{ product.data.category }}</div>
          </div>
        </div>
        <div class="p-card-body">
          <div class="p-cat">{{ product.data.category }}</div>
          <div class="p-name">{{ product.data.title }}</div>
          <div class="p-desc">{{ product.data.description }}</div>
          <div class="p-tags">
            <span class="tag tag-c">{{ product.data.badge }}</span>
            <span class="tag tag-b">{{ product.data.pixel_pitch }}</span>
            <span class="tag tag-g">{{ product.data.brightness }}</span>
          </div>
          <div class="p-footer">
            <div class="p-price"><span class="p-price-label">From</span>Quote</div>
            <a href="{{ product.data.permalink }}" class="btn-glass glass-sm" style="text-decoration:none"><span class="blob"></span><span class="btn-inner">Learn more &rarr;</span></a>
          </div>
        </div>
      </div></div>
      {% endfor %}

      <!-- Outdoor Display (Coming Soon) -->
      <div class="glow-wrap"><div class="p-card">
        <div class="p-card-img" style="background:var(--card-2)">
          <div class="bg-orb" style="width:200px;height:200px;background:var(--P);top:-50px;left:-50px;opacity:0.3"></div>
          <div class="bg-orb" style="width:160px;height:160px;background:var(--C);bottom:-40px;right:-40px;opacity:0.3"></div>
          <span class="p-card-badge" style="background:rgba(111,66,193,0.15);color:var(--P);border:1px solid rgba(111,66,193,0.3)">COMING SOON</span>
          <div style="position:absolute;inset:0;overflow:hidden;display:flex;align-items:center;justify-content:center">
            <div class="img-placeholder" style="width:100%;height:100%;display:flex;align-items:center;justify-content:center">
              <div style="text-align:center; color: rgba(255,255,255,0.3);"><div style="font-size:2rem; margin-bottom:8px;">&#128248;</div><div style="font-size:0.75rem; font-family: var(--fb); letter-spacing:2px; text-transform:uppercase;">[OUTDOOR DISPLAY]</div></div>
            </div>
          </div>
          <div style="position:absolute;bottom:12px;left:0;right:0;text-align:center;z-index:2">
            <div style="font-family:var(--fd);font-weight:700;font-size:0.7rem;color:var(--P);letter-spacing:2px">OUTDOOR SERIES</div>
          </div>
        </div>
        <div class="p-card-body">
          <div class="p-cat">Outdoor LED Panel</div>
          <div class="p-name">Outdoor Displays</div>
          <div class="p-desc">Weather-resistant displays for storefronts and outdoor venues. IP65 rated.</div>
          <div class="p-tags">
            <span class="tag tag-p">Outdoor</span>
            <span class="tag tag-c">IP65</span>
            <span class="tag tag-g">High Brightness</span>
          </div>
          <div class="p-footer">
            <div class="p-price"><span class="p-price-label">From</span>Quote</div>
            <a href="#contact" class="btn-glass glass-sm" style="text-decoration:none"><span class="blob"></span><span class="btn-inner">Contact Us &rarr;</span></a>
          </div>
        </div>
      </div></div>

    </div>
  </div>
</section>


