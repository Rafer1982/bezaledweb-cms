---
layout: base.njk
pageTitle: "Support & Warranty — BEZALED Display Solutions"
metaDescription: "24/7 US-based technical support for every Beza LED installation. 5-year warranty coverage. Call, email, or submit a ticket."
---

<!-- ════════════════════════════════════════════════════════════════════════
     HERO
     ════════════════════════════════════════════════════════════════════════ -->
<section class="page-hero" style="position:relative;z-index:2;">
  <div class="page-hero-inner" style="display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center;">
    <div>
      <div class="page-hero-tag">CUSTOMER SUPPORT</div>
      <h1 class="page-hero-title">Support That's Actually There When You Need It.</h1>
      <p class="page-hero-sub" style="margin-bottom:32px;">24/7 US-based technical assistance for every Beza LED installation. Call us. Email us. We're here.</p>
      <div style="display:flex;gap:12px;flex-wrap:wrap;">
        <a href="tel:{{ site.phone }}" class="btn-glass glass-m" style="text-decoration:none"><span class="blob"></span><span class="btn-inner">Call Support Now</span></a>
        <a href="#ticket" class="btn-glass glass-c" style="text-decoration:none"><span class="blob"></span><span class="btn-inner">Submit a Ticket</span></a>
      </div>
    </div>
    <div>
      <div class="img-placeholder" style="aspect-ratio: 16/9;">
        <div style="text-align:center; color: rgba(255,255,255,0.3);">
          <div style="font-size:2rem; margin-bottom:8px;">🖼</div>
          <div style="font-size:0.75rem; font-family: var(--fb); letter-spacing:2px; text-transform:uppercase;">Support Hero</div>
        </div>
      </div>
      <!-- FLUX PROMPT: Split-screen visualization: left side shows a church LED wall malfunctioning (screen partially dark), right side shows a technician on phone with headset providing remote support, with a laptop showing diagnostic screens. Dark tech aesthetic, cyan and blue color accents. Style: helpful, technical, reassuring. Photorealistic illustration hybrid. -->
    </div>
  </div>
</section>


<!-- ════════════════════════════════════════════════════════════════════════
     HOW TO REACH US
     ════════════════════════════════════════════════════════════════════════ -->
<section style="position:relative;z-index:2;padding:80px 0;">
  <div style="max-width:1200px;margin:0 auto;padding:0 24px;">
    <div style="text-align:center;margin-bottom:48px;">
      <div class="page-hero-tag" style="margin:0 auto 16px;">CONTACT CHANNELS</div>
      <h2 style="font-family:var(--fd);font-size:clamp(1.6rem,4vw,2.4rem);font-weight:700;letter-spacing:-0.02em;">How to Reach Us</h2>
    </div>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px;">

      <!-- Phone Support Card -->
      <div class="mkt-card mkt-card-c">
        <div class="mkt-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--C)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
        </div>
        <div class="mkt-name">Phone Support</div>
        <p class="mkt-desc">Call us anytime — 24 hours, 7 days a week.</p>
        <p style="font-family:var(--fd);font-size:1.1rem;font-weight:700;color:var(--white);margin-bottom:16px;">{{ site.phone_display }}</p>
        <a href="tel:{{ site.phone }}" class="btn-glass glass-c" style="text-decoration:none;display:inline-flex;"><span class="blob"></span><span class="btn-inner">Call Now</span></a>
      </div>

      <!-- Email Support Card -->
      <div class="mkt-card mkt-card-b">
        <div class="mkt-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--B)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        </div>
        <div class="mkt-name">Email Support</div>
        <p class="mkt-desc">Send us a detailed description of your issue. We respond within 2 business hours.</p>
        <p style="font-family:var(--fd);font-size:1.1rem;font-weight:700;color:var(--white);margin-bottom:16px;">{{ site.email }}</p>
        <a href="mailto:{{ site.email }}" class="btn-glass glass-c" style="text-decoration:none;display:inline-flex;"><span class="blob"></span><span class="btn-inner">Email Us</span></a>
      </div>

      <!-- Support Ticket Card -->
      <div class="mkt-card mkt-card-m">
        <div class="mkt-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--M)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 012 2v14a2 2 0 01-2 2H6a2 2 0 01-2-2V6a2 2 0 012-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="8" y1="16" x2="12" y2="16"/></svg>
        </div>
        <div class="mkt-name">Support Ticket</div>
        <p class="mkt-desc">For technical issues, submit a ticket below. Our team will diagnose and respond with a solution.</p>
        <a href="#ticket" class="btn-glass glass-m" style="text-decoration:none;display:inline-flex;margin-top:16px;"><span class="blob"></span><span class="btn-inner">Submit Ticket</span></a>
      </div>

    </div>
  </div>
</section>


<!-- ════════════════════════════════════════════════════════════════════════
     WARRANTY COVERAGE
     ════════════════════════════════════════════════════════════════════════ -->
<section style="position:relative;z-index:2;padding:80px 0;">
  <div style="max-width:1200px;margin:0 auto;padding:0 24px;">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center;">

      <!-- Left: Content -->
      <div>
        <div class="page-hero-tag">WARRANTY</div>
        <h2 style="font-family:var(--fd);font-size:clamp(1.6rem,4vw,2.4rem);font-weight:700;letter-spacing:-0.02em;margin-bottom:12px;">Industry-Leading 5-Year Coverage</h2>
        <p style="color:var(--muted);font-size:0.95rem;line-height:1.7;margin-bottom:32px;">Every Beza LED display ships with comprehensive warranty protection. Here's what's included.</p>

        <!-- Covered -->
        <div style="margin-bottom:28px;">
          <h3 style="font-family:var(--fd);font-size:0.85rem;font-weight:600;text-transform:uppercase;letter-spacing:0.08em;color:var(--C);margin-bottom:16px;">What's Covered</h3>
          <div style="display:flex;flex-direction:column;gap:10px;">
            {% for item in warranty.covered %}
            <div style="display:flex;align-items:center;gap:12px;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--C)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              <span style="font-size:0.9rem;color:var(--white);">{{ item }}</span>
            </div>
            {% endfor %}
          </div>
        </div>

        <!-- Not Covered -->
        <div>
          <h3 style="font-family:var(--fd);font-size:0.85rem;font-weight:600;text-transform:uppercase;letter-spacing:0.08em;color:var(--M);margin-bottom:16px;">Not Covered</h3>
          <div style="display:flex;flex-direction:column;gap:10px;">
            {% for item in warranty.not_covered %}
            <div style="display:flex;align-items:center;gap:12px;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--M)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              <span style="font-size:0.9rem;color:var(--muted);">{{ item }}</span>
            </div>
            {% endfor %}
          </div>
        </div>
      </div>

      <!-- Right: Image -->
      <div>
        <div class="img-placeholder" style="aspect-ratio: 16/9;">
          <div style="text-align:center; color: rgba(255,255,255,0.3);">
            <div style="font-size:2rem; margin-bottom:8px;">🖼</div>
            <div style="font-size:0.75rem; font-family: var(--fb); letter-spacing:2px; text-transform:uppercase;">Warranty Badge</div>
          </div>
        </div>
        <!-- FLUX PROMPT: LED panel cabinet with a glowing holographic 5 YEAR WARRANTY shield floating above it. Dark background, electric cyan and magenta accent lights. Product photography style with CGI warranty badge overlay. Style: premium, reassuring, tech-forward. -->
      </div>

    </div>
  </div>
</section>


<!-- ════════════════════════════════════════════════════════════════════════
     FAQ ACCORDION
     ════════════════════════════════════════════════════════════════════════ -->
<section style="position:relative;z-index:2;padding:80px 0;">
  <div style="max-width:800px;margin:0 auto;padding:0 24px;">
    <div style="text-align:center;margin-bottom:48px;">
      <div class="page-hero-tag" style="margin:0 auto 16px;">FAQ</div>
      <h2 style="font-family:var(--fd);font-size:clamp(1.6rem,4vw,2.4rem);font-weight:700;letter-spacing:-0.02em;">Common Support Questions</h2>
    </div>

    {% for item in faq.items %}
    <div class="faq-item">
      <div class="faq-q">
        <span>{{ item.question }}</span>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
      </div>
      <div class="faq-a">
        <div class="faq-a-inner">{{ item.answer }}</div>
      </div>
    </div>
    {% endfor %}

  </div>
</section>


<!-- ════════════════════════════════════════════════════════════════════════
     SUPPORT TICKET FORM
     ════════════════════════════════════════════════════════════════════════ -->
<section id="ticket" style="position:relative;z-index:2;padding:80px 0;">
  <div style="max-width:1200px;margin:0 auto;padding:0 24px;">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center;">

      <!-- Left: Form -->
      <div>
        <div class="page-hero-tag">SUBMIT A TICKET</div>
        <h2 style="font-family:var(--fd);font-size:clamp(1.6rem,4vw,2.4rem);font-weight:700;letter-spacing:-0.02em;margin-bottom:8px;">Submit a Support Ticket</h2>
        <p style="color:var(--muted);font-size:0.9rem;line-height:1.7;margin-bottom:28px;">Describe your issue in detail and our team will get back to you with a solution.</p>

        <form class="lead-form" style="display:flex;flex-direction:column;gap:14px;">
          <input type="text" name="name" placeholder="Full Name" required style="width:100%;padding:14px 18px;border-radius:14px;border:1px solid rgba(255,255,255,0.12);background:rgba(255,255,255,0.04);color:var(--white);font-family:var(--fb);font-size:0.9rem;outline:none;transition:border-color 0.3s;" onfocus="this.style.borderColor='rgba(0,206,209,0.4)'" onblur="this.style.borderColor='rgba(255,255,255,0.12)'">
          <input type="email" name="email" placeholder="Email" required style="width:100%;padding:14px 18px;border-radius:14px;border:1px solid rgba(255,255,255,0.12);background:rgba(255,255,255,0.04);color:var(--white);font-family:var(--fb);font-size:0.9rem;outline:none;transition:border-color 0.3s;" onfocus="this.style.borderColor='rgba(0,206,209,0.4)'" onblur="this.style.borderColor='rgba(255,255,255,0.12)'">
          <input type="tel" name="phone" placeholder="Phone" style="width:100%;padding:14px 18px;border-radius:14px;border:1px solid rgba(255,255,255,0.12);background:rgba(255,255,255,0.04);color:var(--white);font-family:var(--fb);font-size:0.9rem;outline:none;transition:border-color 0.3s;" onfocus="this.style.borderColor='rgba(0,206,209,0.4)'" onblur="this.style.borderColor='rgba(255,255,255,0.12)'">
          <select name="product" class="form-input" required style="width:100%;padding:14px 18px;border-radius:14px;border:1px solid rgba(255,255,255,0.12);background:rgba(15,18,30,0.9);color:var(--muted);font-family:var(--fb);font-size:0.9rem;outline:none;transition:border-color 0.3s;cursor:pointer;-webkit-appearance:none;-moz-appearance:none;appearance:none;background-image:url('data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2216%22 height=%2216%22 viewBox=%220 0 24 24%22 fill=%22none%22 stroke=%22%239498AC%22 stroke-width=%222%22 stroke-linecap=%22round%22 stroke-linejoin=%22round%22><polyline points=%226 9 12 15 18 9%22/></svg>');background-repeat:no-repeat;background-position:right 16px center;" onfocus="this.style.borderColor='rgba(0,206,209,0.4)'" onblur="this.style.borderColor='rgba(255,255,255,0.12)'">
            <option value="">Select your product...</option>
            {% for product in collections.products %}
            <option value="{{ product.data.slug }}">{{ product.data.title }}</option>
            {% endfor %}
            <option value="outdoor">Outdoor Display</option>
            <option value="other">Other</option>
          </select>
          <textarea name="description" placeholder="Issue Description" rows="5" required style="width:100%;padding:14px 18px;border-radius:14px;border:1px solid rgba(255,255,255,0.12);background:rgba(255,255,255,0.04);color:var(--white);font-family:var(--fb);font-size:0.9rem;outline:none;transition:border-color 0.3s;resize:vertical;min-height:100px;" onfocus="this.style.borderColor='rgba(0,206,209,0.4)'" onblur="this.style.borderColor='rgba(255,255,255,0.12)'"></textarea>
          <!-- Styled file upload -->
          <label style="display:flex;flex-direction:column;gap:8px;cursor:pointer;">
            <span style="font-size:0.82rem;color:var(--soft);font-family:var(--fb);">Attach a Photo (optional)</span>
            <div style="display:flex;align-items:center;gap:14px;padding:16px 20px;border-radius:14px;border:1px dashed rgba(255,255,255,0.15);background:rgba(255,255,255,0.02);transition:border-color 0.3s,background 0.3s;" onmouseover="this.style.borderColor='rgba(0,206,209,0.3)';this.style.background='rgba(0,206,209,0.03)'" onmouseout="this.style.borderColor='rgba(255,255,255,0.15)';this.style.background='rgba(255,255,255,0.02)'">
              <div style="width:40px;height:40px;border-radius:10px;background:rgba(0,206,209,0.08);border:1px solid rgba(0,206,209,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#00CED1" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
              </div>
              <div>
                <div style="font-size:0.85rem;color:var(--white);font-family:var(--fd);font-weight:600;">Click to upload</div>
                <div style="font-size:0.72rem;color:var(--soft);margin-top:2px;">PNG, JPG up to 10MB</div>
              </div>
            </div>
            <input type="file" name="photo" accept="image/*" style="display:none;">
          </label>
          <button type="submit" class="btn-glass glass-full glass-m" style="border:none;cursor:pointer;margin-top:12px;"><span class="blob"></span><span class="btn-inner">Submit Ticket &rarr;</span></button>
        </form>
        <p style="color:var(--soft);font-size:0.78rem;margin-top:14px;">Our team typically responds within 2 business hours.</p>
      </div>

      <!-- Right: Image -->
      <div>
        <div class="img-placeholder" style="aspect-ratio: 16/9;">
          <div style="text-align:center; color: rgba(255,255,255,0.3);">
            <div style="font-size:2rem; margin-bottom:8px;">🖼</div>
            <div style="font-size:0.75rem; font-family: var(--fb); letter-spacing:2px; text-transform:uppercase;">Support Specialist</div>
          </div>
        </div>
        <!-- FLUX PROMPT: Professional customer support specialist with headset at a modern workstation, multiple monitors showing LED system dashboards, dark room with blue ambient lighting. Late night setting (clock showing 2am). Focused, expert. Style: premium tech support, around the clock, trustworthy. -->
      </div>

    </div>
  </div>
</section>
